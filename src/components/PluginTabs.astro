---
// Switch between the two plugin catalogs. Both live under the "Plugins" menu item.
const { active } = Astro.props;
const tabs = [['atak', '/plugins/', 'ATAK'], ['cloudtak', '/plugins/cloudtak/', 'CloudTAK']];
---
<nav class="plug-tabs" aria-label="Plugin catalogs">
  {tabs.map(([k, href, label]) => (
    <a href={href} aria-current={k === active ? 'page' : undefined}>{label}</a>
  ))}
</nav>
