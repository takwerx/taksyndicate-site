---
<Base title="Links" description="Vendors, agencies, communities and tools across the TAK ecosystem.">
  <main id="main">
    <div class="wrap">
      <div class="page-head">
        <h1>Links</h1>
        <p>Vendors, agencies, communities and tools across the TAK ecosystem. Listed to help you find your way, not as endorsements.</p>
      </div>
      <nav class="lk-jump" aria-label="Sections">
        <a href="#orgs">Organizations <span>{links.length}</span></a>
        <a href="#youtube">YouTube channels <span>{channels.length}</span></a>
      </nav>
      <div class="lk-grid" id="orgs">
        {links.map(([img, name, kind, href, look]) => (
          <a class:list={['lk-card', look === 'cover' && 'lk-cover']} href={href} target="_blank" rel="noopener">
            <span class="lk-logo"><img src={img} alt={`${name} logo`} loading="lazy" /></span>
            <span class="lk-plate"><strong>{name}</strong><small>{kind}</small></span>
          </a>
        ))}
      </div>

      <h2 class="section-title" id="youtube"><b>YT</b> YouTube channels</h2>
      <p class="section-note">Channels that teach and show TAK: tutorials, server setup, plugins and field use.</p>
      <div class="lk-grid">
        {channels.map(([img, name, kind, href]) => (
          <a class="lk-card lk-yt" href={href} target="_blank" rel="noopener">
            <span class="lk-logo"><img src={img} alt={`${name} channel`} loading="lazy" /></span>
            <span class="lk-plate"><strong>{name}</strong><small>{kind}</small></span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
