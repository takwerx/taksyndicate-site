---
import Base from '../../layouts/Base.astro';
import { plugins, disciplines, mb, readmeHtml } from '../../lib/plugins.js';
import meta from '../../data/plugin-meta.json';

export function getStaticPaths() {
  return plugins.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const repoUrl = `https://github.com/${p.repo}`;
const s = p.sections;
const m = meta.plugins[p.slug] ?? {};
// Only screenshots picked by hand (plugin-meta.json). The ones in the user guides weren't good enough.
const shots = m.shots ?? [];
// "video" is a YouTube ID, or a list of { id, title } for more than one.
const videos = [m.video ?? []].flat().map((v) => (typeof v === 'string' ? { id: v } : v));
// Number the sections that are present, in order.
let n = 0;
const num = () => String(++n).padStart(2, '0');
// The page is for exposure, not engineering: a short intro up front, the README detail folded away.
const paras = (s.purpose || '').split(/\n\s*\n/);
let introN = 1;
if (paras[0].length < 140 && paras[1] && !/:\s*$/.test(paras[1].trim()) && !/^\s*-/.test(paras[1])) introN = 2;
const intro = paras.slice(0, introN).join('\n\n');
const rest = paras.slice(introN).join('\n\n').trim();
const reqs = [['Features in full', rest], ['Equipment required', s.requires], ['Works with', s.supports], ['Network and security', s.ports]]
  .filter(([, t]) => t && !/^none\.?$/i.test(t.trim()));
---
<Base title={`${p.name} — ATAK plugin`} description={p.description}>
  <main id="main" class="plug-page">
    <div class="wrap">
      <a class="back" href="/plugins/">← All plugins</a>

      <header class="plug-head">
        <span class="plug-icon lg">{p.icon && <img src={p.icon} alt="" width="72" height="72" />}</span>
        <div>
          <h1>{p.name} <span class="ver">v{p.version}</span></h1>
          <p class="plug-lede">{p.description}</p>
          <span class="plug-tags">
            {p.tags.map((t) => disciplines[t] && <a href={`/plugins/#${t}`} style={`--c: ${disciplines[t].c}`}><i></i>{disciplines[t].label}</a>)}
          </span>
        </div>
      </header>

      <div class="plug-layout">
        <aside class="dl-panel">
          <div class="dl-title">Download v{p.version}</div>
          {p.builds.map((b, i) => (
            <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost', 'dl-btn']} href={b.href}>
              ATAK-CIV {b.atak}<span class="btn-sub">{mb(b.size)}</span>
            </a>
          ))}
          <p class="dl-note">Pick the build that matches your ATAK version, then load it in ATAK’s Plugins manager. Or get it through <a href="/plugins/takwerx-market/">TAKwerx Market</a>.</p>
          <div class="dl-links">
            {p.manual && <a href="#manual">User manual</a>}
            {p.guide && <a href={p.guide}>Online guide</a>}
            <a href={p.release}>Release notes</a>
            <a href={repoUrl}>Source code</a>
            <a href={`${repoUrl}/issues`}>Report a problem</a>
          </div>
          {p.slug === 'takwerx-market' && (
            <p class="dl-note">Built a tak.gov-signed ATAK plugin? <a href="https://github.com/takwerx/takwerx-market/blob/main/docs/LIST_YOUR_PLUGIN.md">List it in the Market</a>, then <a href="https://github.com/takwerx/takwerx-market/issues/new?template=list-my-plugin.yml">send a listing request</a>.</p>
          )}
        </aside>

        <div class="plug-main">
          {videos.length > 0 && (
            <section>
              <h2 class="section-title" style="margin-top:0"><b>{num()}</b> Watch</h2>
              <div class:list={['plug-videos', videos.length > 1 && 'two']}>
                {videos.map((v) => (
                  <figure>
                    <div class="embed">
                      <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}`} loading="lazy"
                        title={v.title || `${p.name} video`} allowfullscreen
                        allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
                    </div>
                    {videos.length > 1 && v.title && <figcaption>{v.title}</figcaption>}
                  </figure>
                ))}
              </div>
            </section>
          )}

          {shots.length > 0 && (
            <section>
              <h2 class="section-title" style={videos.length ? undefined : "margin-top:0"}><b>{num()}</b> Screenshots</h2>
              <div class="shots">
                {shots.map((sh, i) => (
                  <a class="shot" href={sh.src} target="_blank" rel="noopener">
                    <img src={sh.src} alt={sh.alt} loading={i < 3 ? 'eager' : 'lazy'} />
                    {sh.alt && <span>{sh.alt}</span>}
                  </a>
                ))}
              </div>
            </section>
          )}

          {s.purpose && (
            <section>
              <h2 class="section-title"><b>{num()}</b> What it does</h2>
              <div class="prose readme plug-intro" set:html={readmeHtml(intro)} />
            </section>
          )}

          {reqs.length > 0 && (
            <details class="plug-more">
              <summary>Technical details <span>features in full, requirements, network</span></summary>
              <div class="prose readme">
                {reqs.map(([h, t]) => (<><h4>{h}</h4><Fragment set:html={readmeHtml(t)} /></>))}
                <p><a href={repoUrl}>More on GitHub →</a></p>
              </div>
            </details>
          )}

          {p.manual && (
            <section>
              <h2 class="section-title" id="manual"><b>{num()}</b> User manual</h2>
              <div class="manual">
                <a class="manual-cover" href={p.manual.href} target="_blank" rel="noopener" data-pdf={p.manual.href}>
                  {p.manual.cover && <img src={p.manual.cover} alt={`${p.name} user manual title page`} loading="lazy" />}
                  <span class="manual-cta">
                    <span class="btn btn-primary">Read the manual</span>
                    <span class="manual-facts">{p.manual.pages && `${p.manual.pages} pages · `}PDF · {mb(p.manual.bytes)}</span>
                  </span>
                </a>
              </div>
              <p class="dl-note"><a href={p.manual.href} download>Download the PDF</a> · The same manual ships inside the plugin, under ATAK’s Tool Preferences.</p>
            </section>
          )}

        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    // Wide screens: open the manual in place. Phones can't embed PDFs well, so the link opens it instead.
    document.querySelectorAll('.manual-cover').forEach(function (a) {
      a.addEventListener('click', function (e) {
        if (window.matchMedia('(max-width: 760px)').matches) return;
        e.preventDefault();
        var frame = document.createElement('div');
        frame.className = 'pdf-frame';
        var o = document.createElement('object');
        o.data = a.dataset.pdf + '#view=FitH'; o.type = 'application/pdf';
        o.innerHTML = '<p class="pdf-fallback">Your browser can’t show the PDF here. <a href="' + a.dataset.pdf + '">Open the manual</a>.</p>';
        frame.appendChild(o);
        a.parentNode.replaceChild(frame, a);
        frame.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</Base>
