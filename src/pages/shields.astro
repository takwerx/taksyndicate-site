---
import Base from '../layouts/Base.astro';

// Public Turnstile site key for the "Submit your shield" form (the secret is a Worker secret).
// Widget "Shield form" in the Cloudflare dashboard (Turnstile), for thetaksyndicate.org and www.
const TURNSTILE_SITE_KEY = '0x4AAAAAAF57aWu_2Glwlokq';

// One card per shield. `team` is the big name, `league` the small line under it.
// Add a shield: drop a transparent .webp in public/images/shields/ and add a row.
const shields = [
  { img: 'img-061', team: 'TAK Texas',            league: 'US · State' },
  { img: 'img-064', team: 'TAK UK',               league: 'United Kingdom' },
  { img: 'mini-workgroups', team: 'Mini workgroups', league: 'Industry · UK', href: 'https://www.miniwg.com/' },
  { img: 'img-065', team: 'TAK-SA',               league: 'South Africa' },
  { img: 'img-070', team: 'Corona Fire',          league: 'Fire department' },
  { img: 'img-063', team: 'TAK California',       league: 'US · State' },
  { img: 'img-077', team: 'COTAK',                league: 'US · Colorado' },
  { img: 'img-076', team: 'TAK Connecticut',      league: 'US · State' },
  { img: 'img-071', team: 'TAK Tennessee',        league: 'US · State' },
  { img: 'img-073', team: 'Frenchy TAK',          league: 'France' },
  { img: 'img-075', team: 'VK SYS',               league: 'Industry', href: 'https://vkintsys.com/' },
  { img: 'img-078', team: 'KWESST',               league: 'Industry · Canada', href: 'https://www.kwesst.com/' },
  { img: 'img-079', team: 'Samsung TAK',          league: 'Industry', href: 'https://www.samsung.com/us/business/solutions/industries/government/' },
  { img: 'img-074', team: 'WFTAK',                league: 'Wildland fire' },
  { img: 'img-069', team: 'TAK Spring Hill',      league: 'Local' },
  { img: 'img-072', team: 'Tough Stump',          league: 'Industry' },
  { img: 'img-062', team: 'PAR TAK',              league: 'Industry' },
  { img: 'img-066', team: 'TAK Arizona',          league: 'US · State' },
  { img: 'img-068', team: 'TAK South Australia',  league: 'Australia · State' },
  { img: 'img-067', team: 'TAK Philippines',      league: 'Philippines' },
  { img: 'img-055', team: 'TAK-J',                league: 'Japan' },
  { img: 'img-058', team: 'Cloud TAK',            league: 'Canada' },
  { img: 'img-059', team: 'NCTAK',                league: 'US · North Carolina' },
  { img: 'img-060', team: 'GEOTAK',               league: 'Community' },
  { img: 'img-057', team: 'Help Now',             league: 'Community' },
  { img: 'img-056', team: 'TAK Australia',        league: 'Australia' },
  { img: 'tak-virginia',  team: 'VA-TAK',             league: 'US · Virginia' },
  { img: 'gsdf-tak',      team: 'GSDF-TAK',           league: 'Georgia State Defense Force' },
  { img: 'georgia-tak',   team: 'Georgia TAK',        league: 'US · State' },
  { img: 'tak-nebraska',  team: 'NE-TAK',             league: 'US · Nebraska' },
  { img: 'usmc-tak',      team: 'USMC TAK',           league: 'US Marine Corps' },
  { img: 'flight-tactics-tak', team: 'Flight Tactics TAK', league: 'Industry', href: 'https://www.flighttactics.com/' },
  { img: 'mytecknet-tak', team: 'myTeckNet TAK',      league: 'Community', href: 'https://mytecknet.com/tag/tak/' },
  { img: 'nz-tak',        team: 'TAK NZ',             league: 'New Zealand', href: 'https://tak.nz/' },
  { img: 'trytak',        team: 'TryTAK',             league: 'Community', href: 'https://trytak.org/' },
  { img: 'tak-alliance',  team: 'TAK Alliance',       league: 'Industry', href: 'https://www.takalliance.org/' },
  { img: 'fltak',         team: 'FLTAK',              league: 'US · State', href: 'https://fltak.us/' },
  { img: 'tak-jbi',       team: 'TAK JBI',            league: 'Industry', href: 'https://jbi-securities.com/' },
  { img: 'all-things-tak', team: 'All Things TAK',    league: 'Community · Livestream', href: 'https://www.youtube.com/@AllThingsTAK-Commercial' },
];
---
<Base title="Shields" description="The TAK community's shields — states, countries, agencies and teams that fly the TAK eagle.">
  <main id="main">
    <div class="wrap">
      <div class="page-head">
        <h1>Shields</h1>
        <p>States, countries, agencies and teams that fly the TAK eagle. {shields.length} and counting.</p>

        <details class="ss" id="submit">
          <summary class="btn btn-ghost">Submit your shield</summary>
          <form class="ss-form" id="ss-form" novalidate>
            <p class="ss-note">Send us your team's shield. We check each one by hand before it goes on this page. Your email is only used to reply to you.</p>
            <div class="ss-grid">
              <label><span class="ss-l">Team or shield name <b>*</b></span>
                <input name="team" required maxlength="60" placeholder="e.g. TAK Ohio" autocomplete="organization" />
              </label>
              <label><span class="ss-l">Small line under the name</span>
                <input name="area" maxlength="60" placeholder="e.g. US · State, Fire department" />
              </label>
              <label><span class="ss-l">Your name <b>*</b></span>
                <input name="name" required maxlength="80" autocomplete="name" />
              </label>
              <label><span class="ss-l">Your email <b>*</b></span>
                <input name="email" type="email" required maxlength="254" autocomplete="email" />
              </label>
              <label class="ss-wide"><span class="ss-l">Website (optional, linked from the card)</span>
                <input name="site" type="url" maxlength="200" placeholder="https://example.org" />
              </label>
              <label class="ss-wide"><span class="ss-l">Comment</span>
                <textarea name="comment" rows="3" maxlength="1000" placeholder="Who uses this shield? Anything we should know?"></textarea>
              </label>
              <label class="ss-wide"><span class="ss-l">Shield image <b>*</b></span>
                <input name="shield" type="file" required accept="image/png,image/jpeg,image/webp" />
                <small>PNG, JPEG or WebP, 2 MB or less. A transparent background looks best.</small>
              </label>
              <label class="ss-hp" aria-hidden="true">Fax <input name="fax" tabindex="-1" autocomplete="off" /></label>
              <label class="ss-check ss-wide">
                <input type="checkbox" name="rights" value="yes" required />
                I made this shield or I have permission to share it, and it may be shown on this page.
              </label>
            </div>
            <div class="ss-ts" id="ss-ts"></div>
            <div class="ss-foot">
              <button class="btn btn-primary" type="submit" id="ss-send">Send shield</button>
              <p class="ss-msg" id="ss-msg" role="status" aria-live="polite"></p>
            </div>
          </form>
        </details>
      </div>
    </div>

    <div class="cards-wrap">
      <div class="bb-grid">
        {shields.map((s, i) => {
          const Tag = s.href ? 'a' : 'div';
          return (
            <Tag class="bb-card" href={s.href} target={s.href ? '_blank' : undefined} rel={s.href ? 'noopener' : undefined}>
              <span class="bb-num">#{String(i + 1).padStart(2, '0')}</span>
              <span class="bb-window">
                <img src={`/images/shields/${s.img}.webp`} alt={`${s.team} shield`} loading={i < 12 ? 'eager' : 'lazy'} />
              </span>
              <span class="bb-plate">
                <strong>{s.team}</strong>
                <small>{s.league}{s.href && ' ↗'}</small>
              </span>
            </Tag>
          );
        })}
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ siteKey: TURNSTILE_SITE_KEY }}>
    // Shield form. Turnstile loads only when the form is opened.
    (function () {
      var box = document.getElementById('submit'), form = document.getElementById('ss-form');
      var msg = document.getElementById('ss-msg'), send = document.getElementById('ss-send');
      var widget = null, loading = false;

      function say(t, bad) { msg.textContent = t; msg.classList.toggle('bad', !!bad); }

      function renderTs() {
        if (widget !== null || !window.turnstile) return;
        widget = window.turnstile.render('#ss-ts', { sitekey: siteKey, action: 'shield-submit', theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark' });
      }
      window.ssTurnstileReady = renderTs;

      function loadTs() {
        if (loading) return renderTs();
        loading = true;
        var s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=ssTurnstileReady';
        s.async = true; s.defer = true;
        document.head.appendChild(s);
      }

      box.addEventListener('toggle', function () { if (box.open) loadTs(); });
      if (location.hash === '#submit') { box.open = true; }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var f = form.shield.files[0];
        if (!f) return say('Attach the shield image.', true);
        if (f.size > 2 * 1024 * 1024) return say('The image is too large. The limit is 2 MB.', true);
        if (!/^image\/(png|jpeg|webp)$/.test(f.type)) return say('Use a PNG, JPEG or WebP image.', true);
        var data = new FormData(form);
        if (!data.get('cf-turnstile-response')) return say('Complete the human check first.', true);

        send.disabled = true; say('Sending…');
        fetch('/api/shield-submit', { method: 'POST', body: data })
          .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'Something went wrong. Try again later.' }; }); })
          .then(function (res) {
            if (res.ok) {
              form.reset(); say('Thank you. We got your shield and will look at it soon.');
            } else {
              say(res.error || 'Something went wrong. Try again later.', true);
            }
          })
          .catch(function () { say('Could not reach the server. Try again later.', true); })
          .finally(function () {
            send.disabled = false;
            if (window.turnstile && widget !== null) window.turnstile.reset(widget);
          });
      });
    })();
  </script>

  <script is:inline>
    // A little tilt and foil shine under the pointer, like holding the card.
    if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
      document.querySelectorAll('.bb-card').forEach(function (c) {
        c.addEventListener('pointermove', function (e) {
          var r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          c.style.setProperty('--rx', ((0.5 - y) * 10).toFixed(2) + 'deg');
          c.style.setProperty('--ry', ((x - 0.5) * 12).toFixed(2) + 'deg');
          c.style.setProperty('--mx', (x * 100).toFixed(1) + '%');
          c.style.setProperty('--my', (y * 100).toFixed(1) + '%');
        });
        c.addEventListener('pointerleave', function () { c.style.removeProperty('--rx'); c.style.removeProperty('--ry'); });
      });
    }
  </script>
</Base>
